# 生成器按字节核对许可证和随包运行时，检出时必须保留 LF。
model-runtime/licenses/* text eol=lf
harness/llm/runtime/* text eol=lf
# 品牌原稿与分发矢量按字节核对，跨平台检出保持一致。
assets/brand/*.svg text eol=lf
web/public/brand/*.svg text eol=lf

# 随版本库分发的预编译 Hex 引擎是二进制，禁止任何文本/换行转换。
# 一旦被当作文本检出，60MB Mach-O / PE 会被改写并导致 engine.json 校验失败。
harness/resources/hex/** binary
# 版本清单与说明是文本：保留可读 diff，让版本/来源变更可被审查；
# 强制 LF，避免 Windows 检出时 CRLF 混入 JSON。-binary 取消上面 binary 宏的
# -diff/-merge/-text，规则在后面优先匹配；引擎二进制本身仍保持 binary。
harness/resources/hex/**/engine.json -binary text eol=lf
harness/resources/hex/README.md -binary text eol=lf
