{
  "title": "小学数学：钱币与预算",
  "description": "四课生活技能：币值、找零、预算计划、迁移到真实购物情境。",
  "assumptions": "整数元金额；硬币 1/5/10 元，纸币 20/50/100 元。",
  "stage1": "观察与预测",
  "stage1goal": "认识币值并会找零。",
  "stage2": "解释与迁移",
  "stage2goal": "计划预算并迁移到购物。",
  "coin-values.title": "硬币与纸币面值",
  "coin-values.goal": "合并硬币面值得总数。",
  "coin-values.reading": "硬币 1/5/10 元按值相加：5+5+1=11 元。按值数，不是按枚数。",
  "coin-values.worked.prompt": "为什么两枚 5 元加一枚 1 元是 11 元？",
  "coin-values.worked.fb": "按值 5+5+1=11。",
  "coin-values.worked.hint": "加面值。",
  "coin-values.worked.content": "5+5+1=11 元，三枚但 11 元。",
  "coin-values.total.prompt": "10+5+1+1 = ? 元",
  "coin-values.total.fb": "17。",
  "coin-values.total.hint": "加所有面值。",
  "coin-values.independent.prompt": "哪组凑 15 元？",
  "coin-values.independent.fb": "10+5。",
  "coin-values.independent.hint": "和为 15。",
  "coin-values.independent.a.label": "10+5",
  "coin-values.independent.a.fb": "15。",
  "coin-values.independent.b.label": "5+5+1",
  "coin-values.independent.b.fb": "11。",
  "coin-values.c1.prompt": "三枚 5 元 = ? 元",
  "coin-values.c1.hint": "值非枚数。",
  "coin-values.c1.a.label": "3",
  "coin-values.c1.a.fb": "那是枚数。",
  "coin-values.c1.b.label": "15",
  "coin-values.c1.b.fb": "5×3。",
  "making-change.title": "找零",
  "making-change.goal": "找零 = 付 − 价。",
  "making-change.reading": "找零是退回的：付减价。付 20 买 13 → 找 7。",
  "making-change.struggle": "不计算，解释为什么找零 = 付 − 价而非价 − 付。",
  "making-change.worked.prompt": "为什么找零是付减价？",
  "making-change.worked.fb": "退回多付的部分。",
  "making-change.worked.hint": "多余退回。",
  "making-change.worked.content": "付 20 买 13：多 7 退回。",
  "making-change.change.prompt": "付 50 买 32：找零？",
  "making-change.change.fb": "50-32=18。",
  "making-change.change.hint": "减价。",
  "making-change.transfer-change.prompt": "付 100 买 68：找零？",
  "making-change.transfer-change.fb": "100-68=32。",
  "making-change.transfer-change.hint": "减。",
  "making-change.c1.prompt": "找零用…",
  "making-change.c1.hint": "差。",
  "making-change.c1.a.label": "减法",
  "making-change.c1.a.fb": "付−价。",
  "making-change.c1.b.label": "加法",
  "making-change.c1.b.fb": "加法求总。",
  "budget-plan.title": "计划预算",
  "budget-plan.goal": "对照预算检查购物清单。",
  "budget-plan.reading": "预算限制总花费：清单求和与上限比；超上限需去掉或换项。",
  "budget-plan.worked.prompt": "预算 30；清单 12+15=27。能买吗？",
  "budget-plan.worked.fb": "27 ≤ 30，能。",
  "budget-plan.worked.hint": "和与上限比。",
  "budget-plan.worked.content": "27 在 30 内剩 3。",
  "budget-plan.sum.prompt": "清单 18+25：总？",
  "budget-plan.sum.fb": "43。",
  "budget-plan.sum.hint": "加。",
  "budget-plan.transfer-budget.prompt": "预算 40；清单 43。怎么办？",
  "budget-plan.transfer-budget.fb": "去掉或换一项。",
  "budget-plan.transfer-budget.hint": "超上限。",
  "budget-plan.transfer-budget.a.label": "仍全买",
  "budget-plan.transfer-budget.a.fb": "超预算。",
  "budget-plan.transfer-budget.b.label": "去掉或换一项",
  "budget-plan.transfer-budget.b.fb": "降到上限内。",
  "budget-plan.c1.prompt": "超预算意味着…",
  "budget-plan.c1.hint": "比较。",
  "budget-plan.c1.a.label": "和 ≤ 上限",
  "budget-plan.c1.a.fb": "那是在内。",
  "budget-plan.c1.b.label": "和 > 上限",
  "budget-plan.c1.b.fb": "超出。",
  "shopping-transfer.title": "真实购物迁移",
  "shopping-transfer.goal": "在一个情境中综合总价、找零与预算。",
  "shopping-transfer.reading": "真实购物串联技能：清单求和、查预算、付钱、算找零。",
  "shopping-transfer.worked.prompt": "清单 25、预算 30、付 50：找零？",
  "shopping-transfer.worked.fb": "50-25=25。",
  "shopping-transfer.worked.hint": "从总价找零。",
  "shopping-transfer.worked.content": "总 25 在 30 内；付 50 → 找 25。",
  "shopping-transfer.total.prompt": "清单 16+19：总？",
  "shopping-transfer.total.fb": "35。",
  "shopping-transfer.total.hint": "加。",
  "shopping-transfer.transfer-chain.prompt": "总 35、预算 40、付 50：找零？",
  "shopping-transfer.transfer-chain.fb": "50-35=15。",
  "shopping-transfer.transfer-chain.hint": "付−总。",
  "shopping-transfer.c1.prompt": "购物数学第一步：",
  "shopping-transfer.c1.hint": "先总。",
  "shopping-transfer.c1.a.label": "清单求和",
  "shopping-transfer.c1.a.fb": "先总。",
  "shopping-transfer.c1.b.label": "算找零",
  "shopping-transfer.c1.b.fb": "找零需总价。",
  "shopping-transfer.c2.prompt": "预算检查比较…",
  "shopping-transfer.c2.hint": "总与上限。",
  "shopping-transfer.c2.a.label": "找零与上限",
  "shopping-transfer.c2.a.fb": "错配。",
  "shopping-transfer.c2.b.label": "总价与上限",
  "shopping-transfer.c2.b.fb": "和与上限。"
}
