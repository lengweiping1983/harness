{
  "title": "小学数学：分数运算",
  "description": "四课从同分母加法到分数小数联系：运算、比较、形式互化。",
  "assumptions": "分母不超过 12；小数为有限小数。不需要联网或器材。",
  "stage1": "观察与预测",
  "stage1goal": "从相等份数建立运算规则。",
  "stage2": "解释与迁移",
  "stage2goal": "比较并在形式间互化。",
  "same-denominator.title": "同分母：加份数",
  "same-denominator.goal": "同分母分数加减。",
  "same-denominator.reading": "份数相等时只变份数个数：2/7 + 3/7 = 5/7；分母不变。",
  "same-denominator.worked.prompt": "为什么 2/7 + 3/7 分母仍是 7？",
  "same-denominator.worked.fb": "份的大小已相同；只变个数。",
  "same-denominator.worked.hint": "同样大小的份。",
  "same-denominator.worked.content": "2/7 + 3/7 = 5/7：五个同样的七分之一。",
  "same-denominator.add.prompt": "2/7 + 3/7：分子是多少？",
  "same-denominator.add.fb": "2 + 3 = 5。",
  "same-denominator.add.hint": "上面数字相加。",
  "same-denominator.independent.prompt": "5/9 - 2/9 = ?",
  "same-denominator.independent.fb": "3/9。",
  "same-denominator.independent.hint": "个数相减。",
  "same-denominator.independent.a.label": "3/9",
  "same-denominator.independent.a.fb": "同分母，分子相减。",
  "same-denominator.independent.b.label": "3/0",
  "same-denominator.independent.b.fb": "分母不相减。",
  "same-denominator.c1.prompt": "4/11 + 5/11 = ?",
  "same-denominator.c1.hint": "分母不变。",
  "same-denominator.c1.a.label": "9/22",
  "same-denominator.c1.a.fb": "分母不相加。",
  "same-denominator.c1.b.label": "9/11",
  "same-denominator.c1.b.fb": "同份，加个数。",
  "common-denominator.title": "让份数匹配",
  "common-denominator.goal": "先通分再相加。",
  "common-denominator.reading": "分母不同意味着份大小不同；先化成相等份：1/2 + 1/4 = 2/4 + 1/4 = 3/4。",
  "common-denominator.worked.prompt": "为什么加 1/4 前要把 1/2 变成 2/4？",
  "common-denominator.worked.fb": "只有同样大小的份才能一起数。",
  "common-denominator.worked.hint": "匹配份的大小。",
  "common-denominator.worked.content": "1/2 = 2/4；然后 2/4 + 1/4 = 3/4。",
  "common-denominator.rename.prompt": "1/2 + 1/4 用四分之一表示：分子是多少？",
  "common-denominator.rename.fb": "2 + 1 = 3。",
  "common-denominator.rename.hint": "把二分之一化成四分之一。",
  "common-denominator.independent.prompt": "1/3 + 1/6 = ?",
  "common-denominator.independent.fb": "3/6 = 1/2。",
  "common-denominator.independent.hint": "用六分之一：2/6 + 1/6。",
  "common-denominator.independent.a.label": "2/9",
  "common-denominator.independent.a.fb": "份没有匹配。",
  "common-denominator.independent.b.label": "3/6",
  "common-denominator.independent.b.fb": "2/6 + 1/6 = 3/6。",
  "common-denominator.c1.prompt": "1/2 + 1/8 用八分之一：分子？",
  "common-denominator.c1.hint": "先通分。",
  "common-denominator.c1.a.label": "5",
  "common-denominator.c1.a.fb": "4/8 + 1/8。",
  "common-denominator.c1.b.label": "2",
  "common-denominator.c1.b.fb": "忘了化 1/2。",
  "compare-fractions.title": "匹配份数再比较",
  "compare-fractions.goal": "用通分或基准比较分数。",
  "compare-fractions.reading": "用相等份或基准 1/2 比较：3/5 > 1/2 因为 3/5 = 6/10 > 5/10。",
  "compare-fractions.struggle": "不算小数，解释如何判断 3/5 与 1/2 谁大。",
  "compare-fractions.worked.prompt": "基准 1/2 如何帮助比较 3/5？",
  "compare-fractions.worked.fb": "3/5 超过 5 份的一半（2.5），故大于 1/2。",
  "compare-fractions.worked.hint": "分母的一半。",
  "compare-fractions.worked.content": "5 的一半是 2.5；3 > 2.5 故 3/5 > 1/2。",
  "compare-fractions.independent.prompt": "哪个大：2/3 还是 3/5？",
  "compare-fractions.independent.fb": "2/3 = 10/15 > 9/15 = 3/5。",
  "compare-fractions.independent.hint": "十五分之一匹配两者。",
  "compare-fractions.independent.a.label": "2/3",
  "compare-fractions.independent.a.fb": "10/15 对 9/15。",
  "compare-fractions.independent.b.label": "3/5",
  "compare-fractions.independent.b.fb": "9/15 更小。",
  "compare-fractions.transfer-recipe.prompt": "配方需 2/3 杯糖；你有 3/5 杯。够吗？",
  "compare-fractions.transfer-recipe.fb": "不够：3/5 < 2/3。",
  "compare-fractions.transfer-recipe.hint": "用相等份比较。",
  "compare-fractions.transfer-recipe.a.label": "够",
  "compare-fractions.transfer-recipe.a.fb": "3/5 比需要的少。",
  "compare-fractions.transfer-recipe.b.label": "不够",
  "compare-fractions.transfer-recipe.b.fb": "9/15 < 10/15。",
  "compare-fractions.c1.prompt": "5/8 与 1/2：",
  "compare-fractions.c1.hint": "8 的一半是 4。",
  "compare-fractions.c1.a.label": "5/8 > 1/2",
  "compare-fractions.c1.a.fb": "4/8 是一半。",
  "compare-fractions.c1.b.label": "5/8 < 1/2",
  "compare-fractions.c1.b.fb": "5 > 4。",
  "fraction-decimal.title": "分数小数是一个想法",
  "fraction-decimal.goal": "分数小数互化并并用。",
  "fraction-decimal.reading": "分数是除法：3/4 = 3 ÷ 4 = 0.75；小数是十分、百分…的分数。",
  "fraction-decimal.worked.prompt": "为什么 3/4 与 0.75 相同？",
  "fraction-decimal.worked.fb": "3 ÷ 4 = 0.75；都叫四等份中的三份。",
  "fraction-decimal.worked.hint": "上除以下。",
  "fraction-decimal.worked.content": "3/4 = 75/100 = 0.75。",
  "fraction-decimal.convert.prompt": "把 3/4 写成小数。",
  "fraction-decimal.convert.fb": "0.75。",
  "fraction-decimal.convert.hint": "75 个百分之一。",
  "fraction-decimal.transfer-half-of.prompt": "10 米的一半是 1/2 × 10。多少米？",
  "fraction-decimal.transfer-half-of.fb": "5 米。",
  "fraction-decimal.transfer-half-of.hint": "一半即除以 2。",
  "fraction-decimal.c1.prompt": "1/4 的小数：",
  "fraction-decimal.c1.hint": "1 除以 4。",
  "fraction-decimal.c1.a.label": "0.14",
  "fraction-decimal.c1.a.fb": "数字不是值。",
  "fraction-decimal.c1.b.label": "0.25",
  "fraction-decimal.c1.b.fb": "25 个百分之一。",
  "fraction-decimal.c2.prompt": "0.5 等于哪个分数？",
  "fraction-decimal.c2.hint": "十分化二分之一。",
  "fraction-decimal.c2.a.label": "1/2",
  "fraction-decimal.c2.a.fb": "十分之五＝一半。",
  "fraction-decimal.c2.b.label": "1/5",
  "fraction-decimal.c2.b.fb": "那是 0.2。"
}
