{
  "title": "初中几何：度量与推理",
  "description": "四课从周长面积到角推理、体积与对称：计算、论证、迁移到真实形状。",
  "assumptions": "长度与角度为整数；需要时 pi 取 3。不需要器材。",
  "stage1": "观察与预测",
  "stage1goal": "从单位正方形建立度量公式。",
  "stage2": "解释与迁移",
  "stage2goal": "推理角、体积与对称。",
  "perimeter-area.title": "周长与面积",
  "perimeter-area.goal": "区分周长（边界）与面积（覆盖）。",
  "perimeter-area.reading": "周长相加边长；面积数单位正方形：矩形 P = 2(l+w)，A = l×w。",
  "perimeter-area.worked.prompt": "为什么面积 l×w 而周长 2(l+w)？",
  "perimeter-area.worked.fb": "面积覆盖每行 w 个正方形；周长走边界。",
  "perimeter-area.worked.hint": "覆盖 vs 走边。",
  "perimeter-area.worked.content": "4×3 矩形：内 12 格，周围 14 单位。",
  "perimeter-area.area.prompt": "矩形 6×4：面积？",
  "perimeter-area.area.fb": "6 × 4 = 24。",
  "perimeter-area.area.hint": "行乘列。",
  "perimeter-area.independent.prompt": "同矩形：周长？",
  "perimeter-area.independent.fb": "2(6+4) = 20。",
  "perimeter-area.independent.hint": "四边相加。",
  "perimeter-area.independent.a.label": "24",
  "perimeter-area.independent.a.fb": "那是面积。",
  "perimeter-area.independent.b.label": "20",
  "perimeter-area.independent.b.fb": "6+4+6+4。",
  "perimeter-area.c1.prompt": "正方形边 5：面积？",
  "perimeter-area.c1.hint": "覆盖，不是边界。",
  "perimeter-area.c1.a.label": "25",
  "perimeter-area.c1.a.fb": "5×5。",
  "perimeter-area.c1.b.label": "20",
  "perimeter-area.c1.b.fb": "那是周长。",
  "triangle-angles.title": "三角形内角和 180",
  "triangle-angles.goal": "用内角和求缺角。",
  "triangle-angles.reading": "任何三角形三内角和 180°；直角 90°。",
  "triangle-angles.struggle": "不测量，解释为什么三角形不能有两个直角。",
  "triangle-angles.worked.prompt": "为什么三角形不能有两个直角？",
  "triangle-angles.worked.fb": "90+90=180 剩 0 给第三角。",
  "triangle-angles.worked.hint": "和必须 180。",
  "triangle-angles.worked.content": "两个直角已用完 180°。",
  "triangle-angles.missing.prompt": "角 50° 与 60°：第三角？",
  "triangle-angles.missing.fb": "180 - 110 = 70。",
  "triangle-angles.missing.hint": "从 180 减。",
  "triangle-angles.transfer-right.prompt": "直角三角形一个 35°。另一锐角？",
  "triangle-angles.transfer-right.fb": "90 - 35 = 55。",
  "triangle-angles.transfer-right.hint": "直角占 90。",
  "triangle-angles.c1.prompt": "角 90° 与 45°：第三？",
  "triangle-angles.c1.hint": "两个都减。",
  "triangle-angles.c1.a.label": "55",
  "triangle-angles.c1.a.fb": "180-135=45。",
  "triangle-angles.c1.b.label": "45",
  "triangle-angles.c1.b.fb": "180-90-45。",
  "volume.title": "体积：单位立方体的层",
  "volume.goal": "体积＝单位立方体的层。",
  "volume.reading": "体积数单位立方体：盒 V = l×w×h；每层 l×w 个。",
  "volume.worked.prompt": "为什么体积 l×w×h？",
  "volume.worked.fb": "h 层每层 l×w 个。",
  "volume.worked.hint": "层乘每层。",
  "volume.worked.content": "3×2×4 盒：4 层每层 6 = 24。",
  "volume.compute.prompt": "盒 5×2×3：体积？",
  "volume.compute.fb": "5×2×3 = 30。",
  "volume.compute.hint": "三个都乘。",
  "volume.transfer-water.prompt": "水箱 10×10×10 cm 半满。水体积？",
  "volume.transfer-water.fb": "1000 / 2 = 500。",
  "volume.transfer-water.hint": "满体积的一半。",
  "volume.c1.prompt": "立方体边 3：体积？",
  "volume.c1.hint": "三维。",
  "volume.c1.a.label": "27",
  "volume.c1.a.fb": "3×3×3。",
  "volume.c1.b.label": "9",
  "volume.c1.b.fb": "那是一个面面积。",
  "symmetry.title": "对称与坐标",
  "symmetry.goal": "识别轴对称并反射点。",
  "symmetry.reading": "对称轴把形状折到自身；(x,y) 关于 y 轴反射得 (-x,y)。",
  "symmetry.worked.prompt": "对称轴做什么？",
  "symmetry.worked.fb": "折叠使两半完全重合。",
  "symmetry.worked.hint": "折叠重合。",
  "symmetry.worked.content": "正方形有 4 条对称轴。",
  "symmetry.reflect.prompt": "把 (3,2) 关于 y 轴反射：",
  "symmetry.reflect.fb": "(-3,2)。",
  "symmetry.reflect.hint": "x 变号。",
  "symmetry.reflect.a.label": "(-3,2)",
  "symmetry.reflect.a.fb": "关于 y 轴镜像。",
  "symmetry.reflect.b.label": "(3,-2)",
  "symmetry.reflect.b.fb": "那是关于 x 轴。",
  "symmetry.transfer-letter.prompt": "哪个字母有竖直对称轴？",
  "symmetry.transfer-letter.fb": "A。",
  "symmetry.transfer-letter.hint": "左右折。",
  "symmetry.transfer-letter.a.label": "F",
  "symmetry.transfer-letter.a.fb": "没有折法重合。",
  "symmetry.transfer-letter.b.label": "A",
  "symmetry.transfer-letter.b.fb": "左右镜像。",
  "symmetry.c1.prompt": "矩形对称轴数：",
  "symmetry.c1.hint": "对角线不算。",
  "symmetry.c1.a.label": "4",
  "symmetry.c1.a.fb": "只有正方形 4。",
  "symmetry.c1.b.label": "2",
  "symmetry.c1.b.fb": "仅中线。",
  "symmetry.c2.prompt": "把 (-4,5) 关于 y 轴反射：",
  "symmetry.c2.hint": "只翻 x。",
  "symmetry.c2.a.label": "(4,5)",
  "symmetry.c2.a.fb": "x 变号。",
  "symmetry.c2.b.label": "(-4,-5)",
  "symmetry.c2.b.fb": "y 不变。"
}
