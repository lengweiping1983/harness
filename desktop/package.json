{
  "name": "harness-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node ../scripts/run_node_tests.mjs tests",
    "test:about-panel": "node tests/about-panel-smoke.mjs",
    "package:prepare": "npm --prefix ../web run build && node prepare-release.mjs",
    "package:dir": "electron-builder --dir --publish never",
    "package": "npm run package:prepare && electron-builder --publish never"
  },
  "devDependencies": {
    "builder-util": "26.15.3",
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.2"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "description": "Harness desktop agent workspace",
  "author": "Harness contributors"
}
