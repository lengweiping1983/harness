{
  "name": "harness-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --outDir ../.run/web-build --emptyOutDir && node ../scripts/publish_web_build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "npm run test:unit && npm run build",
    "i18n:check": "node ../scripts/check_i18n.mjs",
    "pretest": "npm run i18n:check",
    "pretypecheck": "npm run i18n:check",
    "prebuild": "node ../model-runtime/build.mjs --check && npm run i18n:check && npm run ui:check",
    "ui:check": "node ../scripts/check_ui_rules.mjs",
    "test:unit": "node ../scripts/run_web_unit.mjs && node ../scripts/run_node_tests.mjs tests && npm --prefix ../model-runtime test",
    "test:watch": "vitest",
    "test:browser": "node tests/run-core.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@tanstack/react-virtual": "^3.13.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.17",
    "echarts": "^6.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.474.0",
    "mermaid": "^11.17.2",
    "plotly.js-basic-dist-min": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-interpreter": "^2.3.2",
    "vega-lite": "^6.5.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.2.7"
  }
}
